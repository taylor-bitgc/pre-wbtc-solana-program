# Env vars for solana-verify verify-from-repo
# Usage:
#   1) Install direnv (optional): https://direnv.net/
#   2) In repo root: direnv allow
#   3) Or: source ./.envrc

# Solana RPC endpoint (contains API key)
export NETWORK_URL="https://mainnet.helius-rpc.com/?api-key=98300757-c6cc-4d7e-8497-cd81839d8fb7"

# On-chain program id
export PROGRAM_ID="41eYaSsErb92yWqpLftdFNKE3sZTyfsqwevxkpUBUJuv"

# Program library name (from programs/controller/Cargo.toml [lib].name)
export PROGRAM_LIB_NAME="controller"

# GitHub repo path used by solana-verify
export REPO_PATH="taylor-bitgc/pre-wbtc-solana-program"

# Commit hash to verify against (ensure pushed to GitHub)
export COMMIT_HASH="b8d4828013a95f1c188a3648fd71d75c4503c0bb"

# Mount path must contain Cargo.lock (workspace root for this repo)
# Tip: use repo root so solana-verify finds the lockfile and workspace members
export MOUNT_PATH="$(pwd)"

# Helper: build the verify-from-repo command
export VERIFY_CMD="solana-verify verify-from-repo -u \"$NETWORK_URL\" --program-id \"$PROGRAM_ID\" https://github.com/$REPO_PATH --commit-hash \"$COMMIT_HASH\" --library-name \"$PROGRAM_LIB_NAME\" --mount-path \"$MOUNT_PATH\""

# Print a short hint when loaded (direnv only)
if command -v direnv >/dev/null 2>&1; then
  echo "[.envrc] Loaded. Run: $VERIFY_CMD"
fi
